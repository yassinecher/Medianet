# ─────────────────────────────────────────────────────────────
# Medianet Incubateur — environment TEMPLATE.
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env
# Drives BOTH docker-compose.yml (dev) and docker-compose.prod.yml.
# ─────────────────────────────────────────────────────────────

# ── Docker image coordinates ─────────────────────────────────
DOCKER_USERNAME=your-dockerhub-username
TAG=latest

# ── JWT (shared across all services) — REQUIRED ──────────────
# Generate a long random value, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

# ── PostgreSQL (one instance per service, same creds) ────────
POSTGRES_USER=medianet
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_AUTH_DB=auth_db
POSTGRES_CANDIDATURE_DB=candidature_db
POSTGRES_NOTIFICATION_DB=notification_db
POSTGRES_PROGRAMME_DB=programme_db
POSTGRES_ADMIN_AI_DB=admin_ai_db

# ── MinIO (object storage) ───────────────────────────────────
MINIO_ROOT_USER=medianet
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_BUCKET=medianet
# Dev: http://localhost:9000 · Prod: your public API/app domain
MINIO_PUBLIC_URL=http://localhost:9000

# ── RabbitMQ (currently unused — kept internal only) ─────────
RABBITMQ_USER=medianet
RABBITMQ_PASSWORD=change-me-strong-rabbit-password

# ── Email / SMTP — REQUIRED for notifications ────────────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-login
MAIL_PASSWORD=your-smtp-key
MAIL_FROM=no-reply@your-domain
MAIL_FROM_NAME=Medianet Incubateur
FRONTEND_URL=http://localhost:3000

# ── Google Sign-In (PUBLIC client id only — no secret) ───────
GOOGLE_CLIENT_ID=

# ── HuggingFace Inference Providers (Admin AI Assistant) ─────
# Optional — admin can also set these from the backoffice (DB row wins).
HF_TOKEN=
LLM_MODEL=
LLM_BASE_URL=

# ── Ollama (local LLM — only used with the `ai-local` profile) ─
OLLAMA_MODEL=llama3.2

# ── Canva Connect (optional) ─────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8080/api/canva/callback

# ── Pinned third-party image tags (reproducible builds) ──────
# Verify each tag exists for your platform, then pin it here.
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
MC_IMAGE_TAG=RELEASE.2025-04-16T18-13-26Z
OLLAMA_IMAGE_TAG=0.5.7

# ── Frontends (baked at BUILD time) ──────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# ── Admin seed account ───────────────────────────────────────
ADMIN_EMAIL=admin@medianet.dz
ADMIN_PASSWORD=change-me

# ── Optional JVM heap overrides (defaults set in compose) ────
# AUTH_JAVA_OPTS=-Xmx320m
# PROGRAMME_JAVA_OPTS=-Xmx512m
# ADMIN_AI_JAVA_OPTS=-Xmx448m

# ── Deploy (prefer GitHub Secrets over this file) ────────────
# DEPLOY_HOST=your-vps-ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<private key contents>
# DOCKER_PASSWORD=your-dockerhub-password-or-token
